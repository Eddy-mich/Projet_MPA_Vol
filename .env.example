# Modele du fichier .env local (a copier : cp .env.example .env).
# Le fichier .env est ignore par Git : ne jamais versionner de jeton.

# Jeton Duffel en mode test (prefixe duffel_test_). Jamais de jeton duffel_live_.
# Prefere : definir DUFFEL_ACCESS_TOKEN comme variable d'environnement du systeme
# (les services l'y lisent directement, et docker compose l'interpole depuis le shell).
# Sinon, le placer ici dans le fichier .env (ignore par Git).
DUFFEL_ACCESS_TOKEN=

# Hotes de l'infrastructure (valeurs de developpement, hors Docker)
REDIS_HOST=localhost
POSTGRES_HOST=localhost
RABBITMQ_HOST=localhost

# URLs des services, utilisees par la gateway
RECHERCHE_URL=http://localhost:8081
RESERVATION_URL=http://localhost:4000
